# OpenAI-compatible chat endpoint used for answering. DeepSeek is the default.
# Any OpenAI-compatible server works, including a local one (see README).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=your-api-key-here
LLM_MODEL=deepseek-flash

# Optional tuning
# LLM_TIMEOUT_MS=60000
# LLM_MAX_RETRIES=1
# LLM_MAX_TOKENS=8000
# HTTP_TIMEOUT_MS=20000
# HTTP_MIN_HOST_INTERVAL_MS=1000
# RETRIEVAL_TOP_K=6
# RETRIEVAL_MAX_PER_SOURCE=3
# DATA_DIR=data
# PORT=3000
