{
  "name": "xero-research-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence-grounded question answering over publicly gathered Xero research.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "serve": "tsx src/server.ts",
    "cli": "tsx src/cli.ts",
    "gather": "tsx src/cli.ts gather",
    "refresh": "tsx src/cli.ts refresh",
    "ask": "tsx src/cli.ts ask",
    "status": "tsx src/cli.ts status",
    "eval": "tsx eval/run-eval.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "explore": "tsx eval/exploratory/run-exploratory.ts",
    "verify:sources": "tsx eval/exploratory/verify-ground-truth.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
